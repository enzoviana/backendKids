# Database
DATABASE_URL="postgresql://username:password@localhost:5432/kidsmed_db?schema=public"

# Server
PORT=5000
NODE_ENV=development

# JWT Secrets (CHANGEZ CES VALEURS EN PRODUCTION!)
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-this-in-production

# JWT Expiration
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Bcrypt
BCRYPT_ROUNDS=12

# ======================================
# STRIPE - Paiements et abonnements
# ======================================
# Clé secrète Stripe (commence par sk_test_ ou sk_live_)
# Obtenir sur: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_votre_cle_stripe_secrete

# Clé publique Stripe (commence par pk_test_ ou pk_live_)
# Utilisée côté frontend
STRIPE_PUBLIC_KEY=pk_test_votre_cle_stripe_publique

# Webhook secret pour vérifier les événements Stripe
# Obtenir sur: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_votre_webhook_secret

# IDs des prix Stripe pour chaque plan (créés sur Stripe Dashboard)
# Format: price_xxx pour les prix de test, price_xxx pour la production
STRIPE_PRICE_CRECHE_ESSENTIEL=price_creche_essentiel_mensuel
STRIPE_PRICE_CRECHE_PREMIUM=price_creche_premium_mensuel
STRIPE_PRICE_RSAI_BASIC=price_rsai_basic_mensuel
STRIPE_PRICE_RSAI_PRO=price_rsai_pro_mensuel
STRIPE_PRICE_MEDECIN_SOLO=price_medecin_solo_mensuel
STRIPE_PRICE_MEDECIN_GROUPE=price_medecin_groupe_mensuel

# URL de succès/annulation après paiement Stripe
STRIPE_SUCCESS_URL=http://localhost:3000/abonnement/success
STRIPE_CANCEL_URL=http://localhost:3000/abonnement/cancel

# ======================================
# EMAIL - Envoi d'emails (choisir UNE option)
# ======================================

# Option 1: SendGrid (recommandé, simple et fiable)
# Obtenir sur: https://app.sendgrid.com/settings/api_keys
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.votre_cle_api_sendgrid
SENDGRID_FROM_EMAIL=noreply@kidsmed.fr
SENDGRID_FROM_NAME=Kids'Med IA

# Option 2: AWS SES (Amazon Simple Email Service)
# EMAIL_PROVIDER=aws-ses
# AWS_SES_REGION=eu-west-3
# AWS_SES_ACCESS_KEY_ID=votre_access_key
# AWS_SES_SECRET_ACCESS_KEY=votre_secret_key
# AWS_SES_FROM_EMAIL=noreply@kidsmed.fr

# Option 3: SMTP générique (Gmail, Outlook, serveur personnalisé)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votre-email@gmail.com
# SMTP_PASSWORD=votre_mot_de_passe_application
# SMTP_FROM_EMAIL=noreply@kidsmed.fr
# SMTP_FROM_NAME=Kids'Med IA

# ======================================
# APPLICATION - URLs frontend
# ======================================
# URL du frontend pour les liens dans les emails
FRONTEND_URL=http://localhost:3000

# URL de réinitialisation de mot de passe (utilisée dans les emails)
FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/reset-password
