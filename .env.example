# Database
DATABASE_URL="postgresql://username:password@localhost:5432/kidsmed_db?schema=public"

# Server
PORT=5000
NODE_ENV=development

# JWT Secrets (CHANGEZ CES VALEURS EN PRODUCTION!)
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-this-in-production

# JWT Expiration
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Bcrypt
BCRYPT_ROUNDS=12

# ======================================
# STRIPE - Paiements et abonnements
# ======================================

# Activation de Stripe : false = mode MOCK, true = vraie intégration
STRIPE_ENABLED=false

# Clé secrète Stripe (commence par sk_test_ ou sk_live_)
# Obtenir sur: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_votre_cle_stripe_secrete

# Clé publique Stripe (commence par pk_test_ ou pk_live_)
# Utilisée côté frontend
STRIPE_PUBLIC_KEY=pk_test_votre_cle_stripe_publique

# Webhook secret pour vérifier les événements Stripe
# Obtenir sur: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_votre_webhook_secret

# IDs des prix Stripe pour chaque plan (créés sur Stripe Dashboard)
STRIPE_PRICE_CRECHE_ESSENTIEL=price_creche_essentiel_mensuel
STRIPE_PRICE_CRECHE_PREMIUM=price_creche_premium_mensuel
STRIPE_PRICE_RSAI_BASIC=price_rsai_basic_mensuel
STRIPE_PRICE_RSAI_PRO=price_rsai_pro_mensuel
STRIPE_PRICE_MEDECIN_SOLO=price_medecin_solo_mensuel
STRIPE_PRICE_MEDECIN_GROUPE=price_medecin_groupe_mensuel

# URL de succès/annulation après paiement Stripe
STRIPE_SUCCESS_URL=http://localhost:3000/abonnement/success
STRIPE_CANCEL_URL=http://localhost:3000/abonnement/cancel

# ======================================
# SMS/MFA - Authentification à deux facteurs
# ======================================

# Provider SMS (twilio, aws-sns, ou mock)
SMS_PROVIDER=mock

# Mode MOCK : true = logs console, false = vraiment envoyer
SMS_MOCK_MODE=true

# Configuration Twilio (recommandé)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+33123456789

# Configuration AWS SNS (alternative)
# AWS_SNS_REGION=eu-west-3
# AWS_SNS_ACCESS_KEY_ID=your_access_key
# AWS_SNS_SECRET_ACCESS_KEY=your_secret_key

# Expiration code MFA (en secondes)
MFA_CODE_EXPIRATION=300

# ======================================
# EMAIL - Envoi d'emails via SMTP
# ======================================

# Provider email (smtp, sendgrid, aws-ses, ou mock)
EMAIL_PROVIDER=smtp

# Mode MOCK : true = logs console, false = vraiment envoyer
EMAIL_MOCK_MODE=true

# Configuration SMTP (Hostinger, Gmail, Outlook, etc.)
# Pour Hostinger : smtp.hostinger.com, port 587
# Pour Gmail : smtp.gmail.com, port 587
# Pour Outlook : smtp-mail.outlook.com, port 587
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-email@votredomaine.com
SMTP_PASSWORD=votre_mot_de_passe

# Email expéditeur (utilisé dans le champ "From")
SMTP_FROM_EMAIL=noreply@kidsmed.fr
SMTP_FROM_NAME=Kids'Med IA

# ======================================
# APPLICATION - URLs frontend
# ======================================

# Informations de l'application
APP_NAME=Kids'Med IA
APP_SUPPORT_EMAIL=support@kidsmed.fr

# URL de base du frontend
FRONTEND_URL=http://localhost:3000

# URLs pour les liens dans les emails
FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/reset-password
FRONTEND_ACTIVATE_ACCOUNT_URL=http://localhost:3000/activate
FRONTEND_MESSAGES_URL=http://localhost:3000/messages
FRONTEND_TRANSMISSIONS_URL=http://localhost:3000/transmissions
FRONTEND_AFFECTATIONS_URL=http://localhost:3000/affectations
FRONTEND_DOCUMENTS_URL=http://localhost:3000/documents
FRONTEND_VACCINS_URL=http://localhost:3000/vaccins
FRONTEND_ORDONNANCES_URL=http://localhost:3000/ordonnances
FRONTEND_FACTURES_URL=http://localhost:3000/factures
FRONTEND_PREFERENCES_URL=http://localhost:3000/preferences
FRONTEND_SUPPORT_URL=http://localhost:3000/support
