# Base PostgreSQL (Render > New > PostgreSQL > Internal Database URL)
DATABASE_URL=postgresql://user:password@host:5432/kidsmed
# Secret long et aléatoire (signature des jetons et des liens de fichiers)
JWT_SECRET=remplacez-par-une-longue-chaine-aleatoire
PORT=4000
# URL publique de cette API (liens de fichiers) et de l'application
PUBLIC_URL=https://backendkids.onrender.com
FRONTEND_URL=https://kidsmedia.vercel.app
CORS_ORIGINS=https://kidsmedia.vercel.app,https://crossrole-manager.lovable.app
# Optionnel : code SMS fixe accepté (laisser vide en production)
MFA_DEMO_CODE=
# SMS (Twilio) — sans ces valeurs, le code est affiché dans les logs Render
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# E-mails (Resend) — sans clé, les e-mails sont affichés dans les logs
RESEND_API_KEY=
MAIL_FROM=Kids'Med <noreply@votre-domaine.fr>
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Dossier des fichiers (monter un Disk Render sur ce chemin)
UPLOAD_DIR=/var/data/uploads
SEED_PASSWORD=KidsMed2026!
SEED_PHONE=
# Passkeys (Face ID / Touch ID) : domaine de l'application et adresses autorisées
WEBAUTHN_RP_ID=kidsmedia.vercel.app
WEBAUTHN_ORIGINS=https://kidsmedia.vercel.app
