# Kids'Med IA — variables d'environnement (copier vers .env puis renseigner)
# cp .env.example .env

# Base PostgreSQL (Render > New > PostgreSQL > Internal Database URL)
DATABASE_URL=postgresql://user:password@localhost:5432/kidsmed

# Secret long et aléatoire (signature des jetons et des liens de fichiers)
JWT_SECRET=change-me-with-a-long-random-secret

PORT=4000

# URL publique de cette API (liens de fichiers) et de l'application
PUBLIC_URL=https://backendkids.onrender.com
FRONTEND_URL=https://kidsmedia.vercel.app
CORS_ORIGINS=https://kidsmedia.vercel.app,http://localhost:8080

# Optionnel : code SMS fixe accepté (laisser vide en production)
MFA_DEMO_CODE=

# SMS (Twilio) — sans ces valeurs, le code est affiché dans les logs Render
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# E-mails — Provider : auto, smtp ou sendgrid
# auto = votre serveur SMTP s'il est configuré, sinon SendGrid.
# Attention : Render bloque les ports SMTP 25/465/587 sur les services GRATUITS.
# Un service payant (Starter) est nécessaire pour envoyer via SMTP depuis Render.
EMAIL_PROVIDER=auto
EMAIL_FROM=contact@votredomaine.fr
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@votredomaine.fr
SMTP_PASSWORD=
SMTP_FROM_NAME=Kids'Med IA
# Secours optionnel si SMTP n'est pas disponible
SENDGRID_API_KEY=
RESEND_API_KEY=
MAIL_FROM=contact@votredomaine.fr

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Dossier des fichiers (monter un Disk Render sur ce chemin)
UPLOAD_DIR=./uploads
# Secret de signature des URL de fichiers (sinon JWT_SECRET est utilisé)
FILE_SIGN_SECRET=

# Comptes créés par npm run seed
SEED_PASSWORD=
SEED_PHONE=+33600000000

# Passkeys (Face ID / Touch ID) : domaine de l'application et adresses autorisées
WEBAUTHN_RP_ID=kidsmedia.vercel.app
WEBAUTHN_ORIGINS=https://kidsmedia.vercel.app
